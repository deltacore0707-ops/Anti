    hit.Parent                 = row

    local function animate(state)
        local pos = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        local knobBg = state and theme.accent or Color3.fromRGB(225, 225, 225)
