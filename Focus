            { Position = pos, BackgroundColor3 = knobBg }):Play()
        TweenService:Create(track, TweenInfo.new(0.18), { BackgroundColor3 = Color3.fromRGB(8, 5, 20) }):Play()
        TweenService:Create(trackStroke, TweenInfo.new(0.18), { Transparency = state and 0 or 0.55 }):Play()
